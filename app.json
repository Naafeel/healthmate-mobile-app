{
  "expo": {
    "name": "HealthMate",
    "slug": "healthmate-mobile-app",
    "version": "1.0.0",
    "description": "Personal Health & Wellness Tracker — Kingston University / ESOFT coursework",
    "orientation": "default",
    "scheme": "healthmate",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.naafeel.healthmate"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8F7"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
